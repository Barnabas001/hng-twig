{% extends "base.twig" %}

{% block content %}
<section class="dashboard">
  <h2>Dashboard</h2>
  <div class="stats-row">
    <div class="stat-card"><h3>{{ total }}</h3><p>Total</p></div>
    <div class="stat-card"><h3>{{ open }}</h3><p>Open</p></div>
    <div class="stat-card"><h3>{{ resolved }}</h3><p>Resolved</p></div>
  </div>
  <div style="margin-top:20px">
    <a href="?page=tickets" class="button">Manage Tickets</a>
  </div>
</section>
{% endblock %}
